# Backend port.
PORT=8080

# MongoDB connection string and authentication secrets.
MONGO_DB_URL=
JWT_SECRET=
EMAIL_VERIFICATION_SECRET=

# Cloudinary image storage.
CLOUD_NAME=
CLOUD_API=
CLOUD_SECRET=

# Email provider credentials and public site URL.
EMAIL_USER=
EMAIL_PASS=
SITE_URL=

# Use sk_test_ for testing or sk_live_ for real payments. Keep it on the backend.
STRIPE_SECRET_KEY=sk_test_replace_me

# Use the signing secret from the same Stripe mode as STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Customer website URL used for Checkout success and cancel links.
CLIENT_URL=http://localhost:5173